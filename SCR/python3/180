class PingEngine:
    """Industrial multi-threaded TCP ping engine with retries and history"""

    def __init__(self, timeout: float = 0.7, threads: int = 50, retries: int = 3):
        self.timeout = timeout
        self.threads = threads
        self.retries = retries

    @staticmethod
    def tcp_ping_once(host: str, port: int, timeout: float = 0.7) -> Optional[int]:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(timeout)
            start = time.time()
            s.connect((host, port))
            s.close()
            return int((time.time() - start) * 1000)
        except Exception:
            return None

    def tcp_ping(self, host: str, port: int) -> Optional[int]:
        results = []
        for _ in range(self.retries):
            val = self.tcp_ping_once(host, port, self.timeout)
            if val is not None:
                results.append(val)
        if not results:
            return None
        results.sort()
        return results[len(results) // 2]  # median for stability

    def check_proxies(self, proxies: List[ProxyNode]) -> List[ProxyNode]:
        if not proxies:
            return []
        with ThreadPoolExecutor(max_workers=self.threads) as executor:
            futures = {executor.submit(self.tcp_ping, p.server, p.port): p for p in proxies}
            for f in futures:
                p = futures[f]
                try:
                    ping = f.result()
                    p.update_ping(ping)
                except Exception:
                    p.update_ping(None)
        return proxies

