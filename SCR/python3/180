class UniqueNamePool:
    def __init__(self):
        self.used = set()
        self.lock = threading.Lock()

    def get(self, base: str) -> str:
        base = sanitize_name(base) or "Proxy"
        with self.lock:
            name = base
            idx = 2
            while name in self.used:
                name = f"{base} {idx}"
                idx += 1
            self.used.add(name)
            return name

NAME_POOL = UniqueNamePool()

# ===========================
# FINGERPRINT ENGINE
