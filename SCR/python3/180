class SmartAutoSwitch:
    """Automatically switch to the best proxy based on ping and update groups"""

    def __init__(self, proxies: List[ProxyNode], config: dict, interval: int = 10):
        self.proxies = [p for p in proxies if p.alive]
        self.config = config
        self.interval = interval
        self.active_proxy: Optional[ProxyNode] = self.proxies[0] if self.proxies else None
        self.DEFAULT_PING = 1300
        self._stop = False
        self.lock = threading.Lock()

    def update_groups(self):
        """Update all proxy-groups with current alive proxies"""
        names = [p.name for p in self.proxies]
        for g in self.config.get("proxy-groups", []):
            if g["name"] in (
                "Global ©️",
                "Global - UrlTest(Tiers) 🥶",
                "Global - Fallback(Tiers) 🌎",
                "Global - LoadBalance(ch) 🦄",
                "Global - LoadBalance(rr) 🍄",
                "Tier 1 🚀",
                "Tier 2 ⚡️",
                "Tier 3 💎"
            ):
                g["proxies"] = names

    def switch_best_proxy(self):
        """Select proxy with lowest ping"""
        best = self.active_proxy
        best_ping = best.ping if best else self.DEFAULT_PING
        for p in self.proxies:
            ping = p.ping if p.ping is not None else self.DEFAULT_PING
            if ping < best_ping:
                best = p
                best_ping = ping
        if best and best != self.active_proxy:
            self.active_proxy = best
            Logger.info(f"[⚡ AutoSwitch] Switched → {best.name} ({best_ping} ms)")

    def run_loop(self):
        """Continuous loop to update groups and switch proxies"""
        while not self._stop:
            self.switch_best_proxy()
            self.update_groups()
            try:
                with open(OUT_PATH, "w", encoding="utf-8") as f:
                    yaml.safe_dump(self.config, f, allow_unicode=True, sort_keys=False)
            except Exception as e:
                Logger.error(f"Error writing config: {e}")
            time.sleep(self.interval)

    def start(self):
        threading.Thread(target=self.run_loop, daemon=True).start()

    def stop(self):
        self._stop = True
