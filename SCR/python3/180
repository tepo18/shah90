class LiveConfigEngine:
    """Continuously ping proxies, update groups, and save YAML"""

    def __init__(self, proxies: List[ProxyNode], out_path: str, interval: float = 1.0, threads: int = 30):
        self.proxies = proxies
        self.out_path = out_path
        self.interval = interval
        self.threads = threads
        self._stop = False
        self.lock = threading.Lock()
        self.cfg_generator = ConfigGenerator(self.proxies)
        self.writer = SafeFileWriter(self.out_path)
        self.pinger = PingEngine(timeout=0.7, threads=self.threads, retries=3)

    def attach_ping(self, p: ProxyNode) -> ProxyNode:
        ping = self.pinger.tcp_ping(p.server, p.port)
        p.update_ping(ping)
        return p

    def update_loop(self):
        while not self._stop:
            # Multi-threaded ping
            with ThreadPoolExecutor(max_workers=self.threads) as executor:
                self.proxies = list(executor.map(self.attach_ping, self.proxies))

            # Keep only alive proxies
            alive_proxies = [p for p in self.proxies if p.alive]
            alive_proxies.sort(key=lambda x: x.ping if x.ping is not None else 9999)

            # Generate config
            cfg_gen = ConfigGenerator(alive_proxies)
            config = cfg_gen.generate()

            # Save YAML safely
            try:
                self.writer.write(yaml.safe_dump(config, allow_unicode=True, sort_keys=False))
                Logger.debug(f"Live config updated with {len(alive_proxies)} proxies")
            except Exception as e:
                Logger.error(f"Failed to write live config: {e}")

            time.sleep(self.interval)

    def start(self):
        threading.Thread(target=self.update_loop, daemon=True).start()

    def stop(self):
        self._stop = True
