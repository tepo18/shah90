def fingerprint_proxy(p: Dict[str, Any]) -> str:
    raw = (
        str(p.get("type")) +
        str(p.get("server")) +
        str(p.get("port")) +
        str(p.get("uuid") or p.get("password") or "")
    )
    return hashlib.sha256(raw.encode()).hexdigest()

