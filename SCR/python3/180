        for g in self.DEFAULT_GROUPS:
            if g["name"] in ("🛡 Global3", "⚡ Ultra Fastest", "🌟 Stable Fallback"):
                g["proxies"] = ok_names
            elif g["name"] == "💚 Top Fast":
                g["proxies"] = [p["name"] if isinstance(p, dict) else p.name for p in top_fast]
            elif g["name"] == "💛 Top Stable <150ms":
                g["proxies"] = [p["name"] if isinstance(p, dict) else p.name for p in stable]
            elif g["name"] == "⚡ Top 3 AutoSwitch":
                g["proxies"] = [p["name"] if isinstance(p, dict) else p.name for p in top3]
            elif g["name"] in ("♻ Fallback Stable", "🌐 All Proxies"):
                g["proxies"] = all_names
            elif g["name"] == "🏆 BestPing":
