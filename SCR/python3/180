class Logger:
    LEVELS = {"DEBUG": 10, "INFO": 20, "WARN": 30, "ERROR": 40}
    current_level = LEVELS["INFO"]
    lock = threading.Lock()

    @classmethod
    def set_level(cls, level: str):
        if level in cls.LEVELS:
            cls.current_level = cls.LEVELS[level]

    @classmethod
    def _log(cls, level: str, msg: str):
        if cls.LEVELS[level] < cls.current_level:
            return
        with cls.lock:
            ts = time.strftime("%Y-%m-%d %H:%M:%S")
            print(f"[{ts}] [{level}] {msg}", flush=True)

    @classmethod
    def debug(cls, msg: str): cls._log("DEBUG", msg)
    @classmethod
    def info(cls, msg: str): cls._log("INFO", msg)
    @classmethod
    def warn(cls, msg: str): cls._log("WARN", msg)
    @classmethod
    def error(cls, msg: str): cls._log("ERROR", msg)

