def parse_vless(s):
    try:
        u = urlparse(s)
        q = parse_qs(u.query)
        p = {
            "name": uniq_name(unquote(u.fragment) or f"vless-{u.hostname}"),
            "type": "vless",
            "server": u.hostname,
            "port": u.port or 443,
            "uuid": u.username,
            "encryption": "none",
            "network": q.get("type", ["tcp"])[0],
            "udp": True
        }
        if q.get("security", [""])[0] in ("tls", "reality"):
            p["tls"] = True
            p["servername"] = q.get("sni", [u.hostname])[0]
        if p["network"] == "ws":
            p["ws-opts"] = {
                "path": q.get("path", ["/"])[0],
                "headers": {"Host": q.get("host", [u.hostname])[0]}
            }
        return p
    except:
        return None

def parse_vmess(s):
    try:
        raw = base64.b64decode(b64fix(s[8:])).decode()
        j = json.loads(raw)
        p = {
            "name": uniq_name(j.get("ps") or f"vmess-{j['add']}"),
            "type": "vmess",
            "server": j["add"],
            "port": safe_int(j["port"]),
            "uuid": j["id"],
            "alterId": safe_int(j.get("aid", 0)),
            "cipher": j.get("scy", "auto"),
            "network": j.get("net", "tcp"),
            "udp": True
        }
        if j.get("tls") == "tls":
            p["tls"] = True
            p["servername"] = j.get("sni") or j["add"]
        if p["network"] == "ws":
            p["ws-opts"] = {
                "path": j.get("path", "/"),
                "headers": {"Host": j.get("host", j["add"])}
            }
        return p
    except:
        return None

def parse_trojan(s):
    try:
        u = urlparse(s)
        q = parse_qs(u.query)
        return {
            "name": uniq_name(unquote(u.fragment) or f"trojan-{u.hostname}"),
            "type": "trojan",
            "server": u.hostname,
            "port": u.port or 443,
            "password": u.username,
            "tls": True,
            "sni": q.get("sni", [u.hostname])[0],
            "udp": True
        }
    except:
        return None

def parse_ss(s):
    try:
        raw = s[5:]
        if "@" not in raw:
            raw = base64.urlsafe_b64decode(b64fix(raw)).decode()
        creds, hostp = raw.split("@", 1)
        method, password = creds.split(":", 1)
        host, port = split_host_port(hostp.split("#")[0])
        return {
            "name": uniq_name(f"ss-{host}"),
            "type": "ss",
            "server": host,
            "port": port,
            "cipher": method,
            "password": password,
            "udp": True
        }
    except:
        return None

def parse_ssr(s):
    try:
        raw = base64.urlsafe_b64decode(b64fix(s[6:])).decode()
        parts = raw.split(":")
        host, port, proto, method, obfs, pwd = parts[:6]
        password = base64.urlsafe_b64decode(b64fix(pwd)).decode()
        return {
            "name": uniq_name(f"ssr-{host}"),
            "type": "ssr",
            "server": host,
            "port": safe_int(port),
            "protocol": proto,
            "cipher": method,
            "obfs": obfs,
            "password": password
        }
    except:
        return None

def parse_line(s):
    s = sanitize(s)
    if s.startswith("vless://"): return parse_vless(s)
    if s.startswith("vmess://"): return parse_vmess(s)
    if s.startswith("trojan://"): return parse_trojan(s)
    if s.startswith("ss://"): return parse_ss(s)
    if s.startswith("ssr://"): return parse_ssr(s)
    return None
    
