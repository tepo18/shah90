#==========================================================
# UTILS
#==========================================================
def b64fix(s):
    return s + "=" * (-len(s) % 4)

def safe_int(x, d=0):
    try: return int(x)
    except: return d

def sanitize(s):
    return re.sub(r"[\r\n]+", "", str(s)).strip()

_used_names = set()
def uniq_name(base):
    base = sanitize(base)
    name = base
    i = 1
    while name in _used_names:
        name = f"{base}-{i}"
        i += 1
    _used_names.add(name)
    return name

def split_host_port(s):
    if ":" in s:
        h, p = s.rsplit(":", 1)
        return h, safe_int(p)
    return s, None

#==========================================================
# TCP PING
#==========================================================
def tcp_ping(host, port, timeout=PING_TIMEOUT):
    try:
        s = socket.socket()
        s.settimeout(timeout)
        t0 = time.time()
        s.connect((host, port))
        s.close()
        return int((time.time() - t0) * 1000)
    except:
        return None

