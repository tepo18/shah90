def parse_line_any(line):
    for fn in (
        parse_vless,
        parse_trojan,
        parse_ss,
        parse_hysteria1,
        parse_hysteria2,
        parse_http,
        parse_socks
    ):
        p = fn(line)
        if p:
            return [p]

    p = parse_ipport(line)
    return [p] if p else []


def parse_any(text):
    proxies = []
    for ln in text.splitlines():
        ln = ln.strip()
        if not ln:
            continue
        proxies.extend(parse_line_any(ln))
    return proxies
