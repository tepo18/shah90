def parse_ipport(line):
    if ":" in line and "://" not in line:
        try:
            host, port = line.split(":",1)
            return {
                "name": uniq_name(f"raw-{host}"),
                "type": "http",
                "server": host,
                "port": safe_int(port),
                "udp": True
            }
        except:
            return None
    return None


